{
  "name": "smash-house",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:use-postgres": "node scripts/use-postgres.mjs",
    "setup": "prisma db push && npm run db:seed",
    "postinstall": "prisma generate",
    "test:e2e": "node e2e/flow.mjs",
    "build:vercel-demo": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts && next build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
