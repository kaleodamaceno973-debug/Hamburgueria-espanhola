# ─────────────────────────────────────────────────────────────
# Smash House — variáveis de ambiente (copie para .env)
# NUNCA coloque chaves reais neste arquivo.
# ─────────────────────────────────────────────────────────────

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Banco de dados
# Local (SQLite):   file:./dev.db
# Produção (Postgres/Neon/Supabase): postgresql://USER:SENHA@HOST:5432/DB?sslmode=require
DATABASE_URL="file:./dev.db"

# Auth.js — gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
# Em produção atrás de proxy (Vercel define automaticamente)
AUTH_TRUST_HOST="true"

# Login com Google (opcional — o botão só aparece se preenchido)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Pagamento: "demo" (funciona sem chaves) ou "stripe" (modo teste)
PAYMENT_PROVIDER="demo"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Métodos aceitos no Stripe Checkout (Pix exige conta Stripe Brasil): card,pix
STRIPE_PAYMENT_METHODS="card,pix"

# E-mail (opcional). Sem chave, os e-mails ficam registrados no painel admin.
RESEND_API_KEY=""
EMAIL_FROM="Smash House <pedidos@seudominio.com.br>"
# E-mail que recebe aviso de novo pedido (opcional)
ADMIN_NOTIFY_EMAIL=""

# WhatsApp da loja, só dígitos com DDI (ex.: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# Upload de imagens em produção (Vercel Blob). Sem token, salva em /public/uploads (só local).
BLOB_READ_WRITE_TOKEN=""

# Usuário admin criado pelo seed (defina antes de rodar `npm run db:seed`)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
